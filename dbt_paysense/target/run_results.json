{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.12.6", "generated_at": "2026-10-20T17:26:24.986499Z", "invocation_id": "ab6c8ff6-11c8-4ec4-ad47-ed65ae5e16c1", "invocation_started_at": "2026-10-20T17:26:24.501433Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-20T17:26:24.945634Z", "completed_at": "2026-10-20T17:26:24.947870Z"}, {"name": "execute", "started_at": "2026-10-20T17:26:24.947967Z", "completed_at": "2026-10-20T17:26:24.983838Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.038587093353271484, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.paysense.mart_product_kpis", "compiled": true, "compiled_code": "-- PaySense: Monthly product KPI mart\n-- Grain: one row per purchase month\n-- Baseline: January 2017 through July 2018\n-- Population: delivered orders with a review and\n-- a recorded delivery date\n\nWITH baseline AS (\n\n    SELECT\n        DATE_TRUNC('month', purchased_at)\n            AS order_month,\n        order_id,\n        review_score,\n        total_payment,\n        days_late\n\n    FROM \"paysense_analytics\".\"main\".\"fct_order_experience\"\n\n    WHERE purchased_at >= '2017-01-01'\n      AND purchased_at < '2018-08-01'\n      AND order_status = 'delivered'\n      AND review_score IS NOT NULL\n      AND days_late IS NOT NULL\n      AND total_payment IS NOT NULL\n),\n\nmonthly_kpis AS (\n\n    SELECT\n        order_month,\n\n        COUNT(*) AS total_orders,\n\n        AVG(review_score)\n            AS avg_review_score,\n\n        100.0 * AVG(\n            CASE WHEN review_score <= 2\n                THEN 1.0 ELSE 0.0 END\n        ) AS low_rating_pct,\n\n        100.0 * AVG(\n            CASE WHEN days_late > 0\n                THEN 1.0 ELSE 0.0 END\n        ) AS late_delivery_pct,\n\n        AVG(total_payment)\n            AS avg_order_value\n\n    FROM baseline\n    GROUP BY order_month\n)\n\nSELECT *\nFROM monthly_kpis\nORDER BY order_month", "relation_name": "\"paysense_analytics\".\"main\".\"mart_product_kpis\"", "batch_results": null, "overload_results": null}], "elapsed_time": 0.08738088607788086, "args": {"introspect": true, "show": false, "profiles_dir": ".", "state_modified_compare_more_unrendered_values": true, "log_level": "info", "invocation_command": "dbt build --select mart_product_kpis --profiles-dir .", "use_v2_parser": false, "require_source_and_semantic_model_names_without_spaces": false, "static_parser": true, "use_fast_test_edges": false, "validate_macro_args": true, "macro_debugging": false, "require_yaml_configuration_for_mf_time_spines": true, "enable_grouped_warn_error_parser_logs": false, "defer": false, "source_freshness_run_project_hooks": true, "indirect_selection": "eager", "require_sql_header_in_test_configs": false, "which": "build", "log_path": "/Users/jadealpay/Documents/PaySense/dbt_paysense/logs", "exclude_resource_types": [], "use_colors": true, "include_saved_query": false, "project_dir": "/Users/jadealpay/Documents/PaySense/dbt_paysense", "require_unique_project_resource_names": false, "require_corrected_analysis_fqns": false, "support_custom_ref_kwargs": false, "show_all_deprecations": false, "partial_parse": true, "require_all_warnings_handled_by_warn_error": true, "select": ["mart_product_kpis"], "print": true, "v2_parser": "dbt-core-experimental-parser parse", "strict_mode": false, "log_format": "default", "log_format_file": "debug", "warn_error_options": {"error": [], "warn": [], "silence": []}, "maximum_seed_size_mib": 1, "require_ref_searches_node_package_before_root": false, "version_check": true, "require_nested_cumulative_type_params": true, "export_saved_queries": false, "skip_nodes_if_on_run_start_fails": true, "sqlparse": {"MAX_GROUPING_DEPTH": null, "MAX_GROUPING_TOKENS": null}, "send_anonymous_usage_stats": true, "snowflake_projects_otel": false, "use_colors_file": true, "require